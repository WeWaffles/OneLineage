<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <!-- Top app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/m3_text_primary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/header_subtitle_oneui"
                android:textColor="@color/m3_text_secondary"
                android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_m3_tonal"
                android:contentDescription="@string/open_settings"
                android:text="☰"
                android:textAllCaps="false"
                android:textColor="@color/m3_text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- System Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/card_system_status"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_surface_container"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_status_title"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_root_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/status_root_checking"
                android:textColor="@color/m3_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_os_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_userspace_scanning"
                android:textColor="@color/m3_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_image_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_image_checking"
                android:textColor="@color/m3_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Switcher Actions Hero Card -->
        <LinearLayout
            android:id="@+id/card_switch_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface_container"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_userspace_title"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_boot_lineage"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_m3_primary"
                android:text="@string/btn_boot_lineage"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_return_oneui"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_m3_tonal"
                android:text="@string/btn_return_oneui"
                android:textAllCaps="false"
                android:textColor="@color/m3_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Image Management & Flavor Selector Card -->
        <LinearLayout
            android:id="@+id/card_image_management"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface_container"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_title"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_download_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/image_variant_description"
                android:textColor="@color/m3_text_secondary"
                android:textSize="13sp" />

            <!-- Flavor Option 1: Vanilla -->
            <LinearLayout
                android:id="@+id/card_flavor_vanilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/radio_item_selected"
                android:orientation="vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_vanilla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flavor_vanilla_title"
                            android:textColor="@color/m3_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/flavor_vanilla_description"
                            android:textColor="@color/m3_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Flavor Option 2: MindTheGapps -->
            <LinearLayout
                android:id="@+id/card_flavor_gapps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/radio_item_unselected"
                android:orientation="vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_gapps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flavor_gapps_title"
                            android:textColor="@color/m3_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/flavor_gapps_description"
                            android:textColor="@color/m3_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Download Progress Bar & Text -->
            <ProgressBar
                android:id="@+id/pb_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_download_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <!-- Buttons: Download & Delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_download_lineage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="@string/btn_download_lineage"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btn_delete_lineage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_m3_danger"
                    android:text="@string/btn_delete_lineage"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_error"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- One UI Protection Card -->
        <LinearLayout
            android:id="@+id/card_launcher_safety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface_container"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_safety_title"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/launcher_safety_description"
                android:textColor="@color/m3_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_backup_launcher"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="@string/btn_backup_launcher"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btn_restore_launcher"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="@string/btn_restore_launcher"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Operation Log Card -->
        <LinearLayout
            android:id="@+id/card_operation_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface_container"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_log_title"
                    android:textColor="@color/m3_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_log_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textColor="@color/m3_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/log_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/log_container"
                android:scrollbars="vertical"
                android:fillViewport="true"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_console_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="@string/log_initialized"
                    android:textColor="@color/m3_log_text"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
