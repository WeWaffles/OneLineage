 /*
+ * Bootstrap console block. start.s installs the bootstrap mapping for it,
+ * sweet_early.c writes to it before IOKit exists, and arm_vm_init keeps it
+ * reachable from a kernel VA once TTBR0 is gone. All three have to agree, so
+ * the address, the geometry and the memory attributes live here.
+ *
+ * The phone build draws text into the panel framebuffer. start.s maps the
+ * console as a single 32MB block descriptor in the first bootstrap L2 table,
+ * which covers one 64GB L1 entry in 2048 blocks, so a replacement address has
+ * to land in that same table.
+ */
+#if defined(ASSEMBLER)
+#define SWEET_EARLY_CONSOLE_PHYS   0x9c000000
+#else
+#define SWEET_EARLY_CONSOLE_PHYS   0x9c000000ULL
+#endif
+#define SWEET_EARLY_CONSOLE_ATTRINDX  CACHE_ATTRINDX_WRITECOMB
+#define SWEET_EARLY_FB_WIDTH       1080
+#define SWEET_EARLY_FB_HEIGHT      2400
+#define SWEET_EARLY_FB_STRIDE      4320
+/* Pixels of stage-marker band drawn along the bottom edge of the panel. */
+#define SWEET_EARLY_MARK_BAND      32
+
+/*
  * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
